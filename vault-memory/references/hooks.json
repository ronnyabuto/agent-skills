{
  "env": {
    "AGENT_VAULT": "/home/you/path/to/vault",
    "VAULT_MEMORY_EXCLUDE": ""
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.claude/skills/vault-memory/scripts/vault.mjs hook",
            "timeout": 30
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.claude/skills/vault-memory/scripts/vault.mjs hook",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.claude/skills/vault-memory/scripts/vault.mjs hook",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
